model User {
    id           String       @id @default(uuid())
    name         String?
    email        String       @unique
    password     String
    ActiveStatus ActiveStatus @default(Active)
    role         Role         @default(USER)
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt
    profile      Profile?
    @@map("users")
}

